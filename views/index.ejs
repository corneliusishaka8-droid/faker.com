<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Randomizer</title>
    <link rel="stylesheet" href="/styles,.css" />
  </head>
  <body>
    <main>
      <h1>randomizer</h1>
      <section>
        <p>generate real random data from the web with just one click</p>

        <div class="format">
          <div>
            <label for="fullname">fullname</label>
            <input type="checkbox" name="fullname" id="fullname" />
          </div>
          <div>
            <label for="bio">bio</label>
            <input type="checkbox" name="bio" id="bio" />
          </div>
          <div>
            <label for="gender">gender</label>
            <input type="checkbox" name="gender" id="gender" />
          </div>
          <div>
            <label for="jobtitle">jobtitle</label>
            <input type="checkbox" name="jobtitle" id="jobtitle" />
          </div>
          <div>
            <label for="jobtype">jobtype</label>
            <input type="checkbox" name="jobtype" id="jobtype" />
          </div>
          <div>
            <label for="phone">phone</label>
            <input type="checkbox" name="phone" id="phone" />
          </div>
          <div>
            <label for="email">email</label>
            <input type="checkbox" name="email" id="email" />
          </div>
          <div>
            <label for="password">password</label>
            <input type="checkbox" name="password" id="password" />
          </div>
          <div>
            <label for="zodic">zodic</label>
            <input type="checkbox" name="zodic" id="zodic" />
          </div>
          <div>
            <label for="usernaame">username</label>
            <input type="checkbox" name="usernaame" id="usernaame" />
          </div>
        </div>

        <button id="generate">generate</button>

        <div class="span-class" id="div-class" hidden></div>

        <div>
          <button id="regenerate">regenerate</button>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="footer-card">
        <div>
          <h3>How to use</h3>
          <p>Select the fields you want, click generate, and the app will display only your chosen fake profile details.</p>
        </div>
        <div>
          <h3>What it does</h3>
          <p>It creates realistic random user data like names, email, phone numbers, job information, and more for testing or mockups.</p>
        </div>
        <div>
          <h3>Developer</h3>
          <p>Built by Cornelius with Express, EJS, and Faker.js.</p>
        </div>
      </div>
    </footer>

    <script id="user-data" type="application/json">
      <%- JSON.stringify(user) %>
    </script>
    <script>
      const userData = document.getElementById("user-data");
      window.user = userData ? JSON.parse(userData.textContent) : {};
    </script>
    <script src="/main.js"></script>
  </body>
</html>